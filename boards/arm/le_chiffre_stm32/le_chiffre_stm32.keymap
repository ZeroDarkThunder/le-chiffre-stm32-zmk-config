#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define NAV_L 1

// Using layer taps on thumbs, having quick tap as well helps w/ repeating space/backspace
&lt { quick_tap_ms = <200>; };

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "homerow mods";
            #binding-cells = <2>;
            tapping_term_ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
        // Rotary encoder: mouse scrolling
        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";

            bindings = <
                &kp Q      &kp W      &kp E       &kp R          &kp T         &kp Y            &kp U          &kp I       &kp O      &kp P
                &kp A      &kp S      &kp D       &kp F          &kp G         &kp H            &kp J          &kp K       &kp L      &kp SEMI
                &kp Z      &kp X      &kp C       &kp V          &kp B         &kp N            &kp M          &kp COMMA   &kp DOT    &kp FSLH
                                                  &kp RET        &kp BSPC      &lt NAV_L SPACE  &kp RSHFT
            >;
            sensor-bindings = <&scroll_encoder>;
        };

        nav_layer {
            display-name = "navigation";

            bindings = <
                &kp ESC     &kp GRAVE     &kp FSLH      &trans          &trans       &trans           &kp N7         &kp N8      &kp N9     &kp N0
                &kp LBKT    &kp RBKT      &kp EQUAL     &kp MINUS       &trans       &trans           &kp N4         &kp N5      &kp N6     &kp SQT
                &trans      &trans        &trans        &trans          &trans       &trans           &kp N1         &kp N2      &kp N3     &trans 
                                                        &kp LGUI        &kp BSPC     &trans           &kp LCTRL 
            >;
            sensor-bindings = <&scroll_encoder>;
        };
    };
};
