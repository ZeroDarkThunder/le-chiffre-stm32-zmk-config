#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define NAV_L 1

// Using layer taps on thumbs, having quick tap as well helps w/ repeating space/backspace
&lt { quick_tap_ms = <200>; };

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "homerow mods";
            #binding-cells = <2>;
            tapping_term_ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
        // Rotary encoder: mouse scrolling
        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";

            bindings = <
                &kp Q      &kp W      &kp E       &kp R          &kp T         &kp Y            &kp U          &kp I       &kp O      &kp P
                &kp A      &kp S      &kp D       &kp F          &kp G         &kp H            &kp J          &kp K       &kp L      &kp SEMI
                &kp Z      &kp X      &kp C       &kp V          &kp B         &kp N            &kp M          &kp COMMA   &kp DOT    &kp BSLH 
                                                  &kp LGUI       &kp BSPC      &lt NAV_L SPACE  &kp RSHFT
            >;
            sensor-bindings = <&scroll_encoder>;
        };

        nav_layer {
            display-name = "navigation";

            bindings = <
                &kp ESC     &kp NUMBER_7  &kp NUMBER_8   &kp NUMBER_9       &kp NUMBER_0 &trans           &kp LBKT       &kp RBKT    &kp SLASH  &GRAVE
                &kp TAB     &kp NUMBER_4  &kp NUMBER_5   &kp NUMBER_6       &trans       &kp LEFT         &kp DOWN       &kp UP      &kp RIGHT  &kp SQT
                &trans      &kp NUMBER_1  &kp NUMBER_2   &kp NUMBER_3       &trans       &kp LCTRL        &kp MINUS      &kp EQUAL   &trans     &trans 
                                                         &kp RET            &kp BSPC     &trans           &kp RSHFT 
            >;
            sensor-bindings = <&scroll_encoder>;
        };
    };
};
